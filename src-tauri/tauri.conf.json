{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graveyard Keeper 2 Save Editor",
  "version": "0.1.1",
  "identifier": "com.netroscript.gk2-savegame-editor",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../build/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Graveyard Keeper 2 Save Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2OEJBMkYzQzNFNzkwNjAKUldSZ2tPZkQ4NktMTnZ2cnRpQ1dWK1NmOENzNHA2eWpVbWJhNTladXhjcFRhSTVpZkg3N2pGOFQK",
      "endpoints": [
        "https://github.com/NetroScript/graveyard-keeper-2-savegame-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "name": "graveyard-keeper-2-savegame-editor",
  "version": "0.1.1",
  "description": "Save editor for Graveyard Keeper 2",
  "type": "module",
  "scripts": {
    "pack:assets": "node scripts/pack-assets.mjs",
    "test:assets": "node --test tests/assets/*.test.mjs",
    "test:assets:browser": "node --test tests/assets/render.browser.mjs",
    "dev": "pnpm build:wasm && node scripts/frontend.mjs browser dev",
    "build": "pnpm build:web",
    "build:wasm": "wasm-pack build crates/save-wasm --target web --out-dir ../../static/wasm --release",
    "build:web": "pnpm build:wasm && node scripts/frontend.mjs browser build",
    "dev:desktop": "node scripts/frontend.mjs desktop dev",
    "build:desktop": "node scripts/frontend.mjs desktop build",
    "release:local": "node scripts/release.mjs",
    "release:stage-assets": "node scripts/stage-release-assets.mjs",
    "test:core": "cargo test -p gk2-save-core",
    "test:wasm": "node scripts/verify-wasm.mjs",
    "test:browser": "pnpm build:web && playwright test",
    "preview": "pnpm build:web && node scripts/frontend.mjs browser preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.3",
    "fz-search": "^1.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.16",
    "wasm-pack": "^0.15.0"
  }
}
